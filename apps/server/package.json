{
  "name": "@tandem/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@tandem/core": "workspace:*",
    "lib0": "^0.2.120",
    "ws": "^8.22.2",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.15"
  }
}
